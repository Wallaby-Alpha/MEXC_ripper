# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MEXC API Credentials (Optional - public market endpoints do not require keys)
MEXC_API_KEY=
MEXC_API_SECRET=

# Operational Mode
# Set to true to print Telegram messages to console/log instead of sending to Telegram API
DRY_RUN=false
LOG_LEVEL=INFO
