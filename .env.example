# ==============================================================================
# MEXC Altcoin Momentum Scanner: Environment Configuration
# ==============================================================================

# MEXC API Credentials (Optional - public market endpoints used by default)
MEXC_API_KEY=
MEXC_API_SECRET=

# Telegram Interactive Bot Configuration
# 1. Create a bot with @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# 2. Send a message to @userinfobot or @RawDataBot to get your TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Alerts (Optional webhook URL)
DISCORD_WEBHOOK_URL=

# WEEX Exchange Execution Bridge Configuration
WEEX_API_KEY=
WEEX_API_SECRET=
WEEX_PASSPHRASE=
# Master Live Trading Safeguard:
# 'false' = Dry-run / paper execution only (Default)
# 'true'  = Real capital order placement on WEEX
WEEX_LIVE_TRADING_ENABLED=true
# Margin Size per Trade in USDT (Default: 10.0)
WEEX_TRADE_SIZE_USDT=10.0
# Leverage Multiplier (Default: 10x)
WEEX_LEVERAGE=10

# Scanner Settings
SCANNER_POLL_INTERVAL_SEC=60
DEFAULT_MIN_24H_TURNOVER_USDT=50000
