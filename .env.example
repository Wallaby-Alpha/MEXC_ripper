# ==============================================================================
# MEXC Altcoin Momentum Scanner & WEEX Live Trader: Environment Config
# ==============================================================================

# 1. Telegram Interactive Bot (Required for Telegram alerts & remote commands)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# 2. WEEX Futures Live Trading API (Required for live trade execution on WEEX)
WEEX_API_KEY=""
WEEX_API_SECRET=""
WEEX_PASSPHRASE=""
WEEX_BASE_URL="https://api-contract.weex.com"

# Master Execution Safeguard: 'true' = Live trading on WEEX | 'false' = Paper trading
WEEX_LIVE_TRADING_ENABLED=true

# Capital Allocation & Risk Management
WEEX_TRADE_SIZE_USDT=1.0        # $1.00 USDT Margin per trade ($10.00 Notional @ 10x)
WEEX_LEVERAGE=10
WEEX_MAX_MARGIN_MULTIPLIER=1.30 # Safeguard collar against min order size budget overflow

# 3. MEXC Market Data (Optional - Public market data endpoints do NOT require API keys)
MEXC_API_KEY=""
MEXC_API_SECRET=""
